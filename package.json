{
  "name": "dexter-ts",
  "version": "2.4.1",
  "description": "Dexter - AI agent for deep financial research.",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "dexter-ts": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build": "bun build src/index.tsx --target=bun --packages=external --outdir=dist",
    "build:web": "bun run scripts/build-web.ts",
    "test:web": "playwright test",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.1.3",
    "@langchain/core": "^1.1.0",
    "@langchain/google-genai": "^2.0.0",
    "@langchain/openai": "^1.1.3",
    "@langchain/tavily": "^1.0.1",
    "dotenv": "^17.2.3",
    "ink": "^6.5.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.13",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
