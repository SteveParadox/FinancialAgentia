{
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "enum": [
        "market",
        "fundamental",
        "news",
        "quantitative",
        "risk",
        "research"
      ],
      "title": "Agent Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "evidence_references": {
      "items": {
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "findings": {
      "additionalProperties": true,
      "title": "Findings",
      "type": "object"
    },
    "input_schema_version": {
      "const": 1,
      "default": 1,
      "title": "Input Schema Version",
      "type": "integer"
    },
    "output_schema_version": {
      "const": 1,
      "default": 1,
      "title": "Output Schema Version",
      "type": "integer"
    },
    "retry_eligible": {
      "default": false,
      "title": "Retry Eligible",
      "type": "boolean"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "uncertainty": {
      "default": "Provider limitations and coverage must be reviewed in the report",
      "title": "Uncertainty",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage"
    }
  },
  "required": [
    "agent_id",
    "execution_id",
    "task_id",
    "status",
    "tools"
  ],
  "title": "AgentExecution",
  "type": "object"
}
