{
  "$defs": {
    "AgentExecution": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "enum": [
            "market",
            "fundamental",
            "news",
            "quantitative",
            "risk",
            "research"
          ],
          "title": "Agent Id",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Evidence References",
          "type": "array"
        },
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "findings": {
          "additionalProperties": true,
          "title": "Findings",
          "type": "object"
        },
        "input_schema_version": {
          "const": 1,
          "default": 1,
          "title": "Input Schema Version",
          "type": "integer"
        },
        "output_schema_version": {
          "const": 1,
          "default": 1,
          "title": "Output Schema Version",
          "type": "integer"
        },
        "retry_eligible": {
          "default": false,
          "title": "Retry Eligible",
          "type": "boolean"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "uncertainty": {
          "default": "Provider limitations and coverage must be reviewed in the report",
          "title": "Uncertainty",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage"
        }
      },
      "required": [
        "agent_id",
        "execution_id",
        "task_id",
        "status",
        "tools"
      ],
      "title": "AgentExecution",
      "type": "object"
    },
    "FinancialClaim": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "validation_status": {
          "const": "VERIFIED",
          "default": "VERIFIED",
          "title": "Validation Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "claim_id",
        "statement",
        "metric",
        "value",
        "supporting_evidence_ids"
      ],
      "title": "FinancialClaim",
      "type": "object"
    },
    "FinancialEvidence": {
      "properties": {
        "calculation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Method"
        },
        "calculation_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Version"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "data_as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data As Of"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "filing_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filing Date"
        },
        "fiscal_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fiscal Period"
        },
        "freshness": {
          "default": "unverified",
          "enum": [
            "historical",
            "stale",
            "unverified",
            "reported_period"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "input_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Input Evidence Ids",
          "type": "array"
        },
        "issuer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer Id"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "period_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Start"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "source_document_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Document Url"
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "symbol",
        "metric",
        "value",
        "evidence_type"
      ],
      "title": "FinancialEvidence",
      "type": "object"
    },
    "FinancialSource": {
      "properties": {
        "accession_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accession Number"
        },
        "adjustment_status": {
          "default": "unspecified",
          "title": "Adjustment Status",
          "type": "string"
        },
        "cache_status": {
          "default": "unspecified",
          "title": "Cache Status",
          "type": "string"
        },
        "data_as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data As Of"
        },
        "document_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Type"
        },
        "exchange": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headline"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "verification_status": {
          "default": "SINGLE_PROVIDER",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "provider",
        "retrieved_at"
      ],
      "title": "FinancialSource",
      "type": "object"
    }
  },
  "properties": {
    "agent_executions": {
      "items": {
        "$ref": "#/$defs/AgentExecution"
      },
      "title": "Agent Executions",
      "type": "array"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/FinancialClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/FinancialEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "model_metadata": {
      "additionalProperties": true,
      "title": "Model Metadata",
      "type": "object"
    },
    "researched_at": {
      "format": "date-time",
      "title": "Researched At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/FinancialSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "session_id",
    "status",
    "answer"
  ],
  "title": "ResearchReport",
  "type": "object"
}
