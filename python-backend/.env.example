# Required for durable jobs. Use managed Redis with TLS/ACL/backups in production.
REDIS_URL=redis://127.0.0.1:6379/0
EXECUTION_REDIS_PREFIX=financialagentia:
BACKEND_ENV=development
# Choose BACKEND_API_KEY for a single trusted account OR JWT_SECRET for users.
BACKEND_API_KEY=
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
SECURE_COOKIES=false
# Optional provider SDKs must be installed to use non-default providers.
# OpenAI is the default. No Ollama service is needed for this configuration.
# Use a chat-completions-compatible model available to your API project.
# Explicit provider syntax also supports custom IDs: openai/<model-id>
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
FINANCIAL_DATASETS_API_KEY=
FINANCIAL_DATA_TIMEOUT_SECONDS=12
AGENT_MAX_ITERATIONS=3
AGENT_EXECUTION_DEADLINE_SECONDS=300
RESEARCH_MAX_ACTIVE_PER_USER=5
CORS_ORIGINS=http://127.0.0.1:3000
# Whole-attempt budgets (all transport retries and structured repair calls count).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4096
RESEARCH_MAX_MODEL_CALLS=24
RESEARCH_MAX_RESERVED_OUTPUT_TOKENS=98304
RESEARCH_MAX_MODEL_INPUT_CHARACTERS=350000
# Terminal artifacts retained from completion; Redis persistence/backups still required.
RESEARCH_RETENTION_SECONDS=86400
# Age labels are not proof of live entitlement or the latest published filing.
MARKET_SNAPSHOT_MAX_AGE_SECONDS=345600
FINANCIAL_STATEMENT_MAX_AGE_DAYS=550
# Optional absolute browser build directory; defaults to ../dist/web in a checkout.
# WEB_DIST_DIR=/app/web

# Optional independently configured original filing source. Both are required.
# SEC_USER_AGENT must contain your real organization and operator contact email.
SEC_USER_AGENT=
# JSON example structure: {"SYMBOL":{"cik":"10-digit issuer ID","exchange":"venue","name":"issuer"}}
# Use verified real mappings; no ticker-to-CIK guessing occurs.
SEC_COMPANIES={}
# New platform documents expire 90 days after creation by default (1h..365d).
# Edits do not extend retention. This is independent of execution retention above.
PLATFORM_RETENTION_SECONDS=7776000
# Live SEC tests require RUN_LIVE_SEC=1 plus valid contact/mappings; never enabled in CI.
